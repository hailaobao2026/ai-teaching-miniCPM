# Leave blank to use the local, clearly-labelled Mock teaching mode.
# Real model path: point to a running vLLM-Omni OpenAI-compatible server.
VLLM_OMNI_URL=
MINICPM_MODEL=openbmb/MiniCPM-o-4_5
VLLM_OMNI_TLS_VERIFY=true
# Legacy alias kept for compatibility with older docs/scripts.
MINICPM_GATEWAY_URL=
MINICPM_TLS_VERIFY=true

# CORS: include Vite dev origin when using frontend npm run dev
MATH_COACH_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3000

# Auth / RBAC
MATH_COACH_AUTH_REQUIRED=true
ADMIN_EMAIL=teacher@demo.local
ADMIN_PASSWORD=demo123
ADMIN_NICKNAME=系统管理员
SEED_DEMO_ACCOUNTS=true
DEMO_TEACHER_EMAIL=math.teacher@demo.local
DEMO_TEACHER_PASSWORD=demo123
DEMO_TEACHER_NICKNAME=数学老师
DEMO_STUDENT_EMAIL=student@demo.local
DEMO_STUDENT_PASSWORD=demo123
DEMO_STUDENT_NICKNAME=演示学生
DEMO_STUDENT_GRADE=grade8

# Database backend: sqlite (default) or mysql
MATH_COACH_DB_BACKEND=sqlite
MATH_COACH_SQLITE_PATH=data/math-coach.db
# Legacy JSON path is only used to derive the default sqlite directory.
MATH_COACH_AUTH_DB=data/auth-db.json

# MySQL (used when MATH_COACH_DB_BACKEND=mysql)
MATH_COACH_MYSQL_HOST=127.0.0.1
MATH_COACH_MYSQL_PORT=3306
MATH_COACH_MYSQL_USER=mathcoach
MATH_COACH_MYSQL_PASSWORD=mathcoach
MATH_COACH_MYSQL_DATABASE=mathcoach
# Optional full DSN override:
# MATH_COACH_MYSQL_DSN=mysql+pymysql://mathcoach:mathcoach@127.0.0.1:3306/mathcoach

# Docker Compose notes:
# - default SQLite file: /app/data/math-coach.db (volume math_coach_data)
# - MySQL profile: MATH_COACH_DB_BACKEND=mysql docker compose --profile mysql up --build -d
# - change ADMIN_PASSWORD before public deployment
# - set MATH_COACH_ALLOWED_ORIGINS to your real browser origin
# MATH_COACH_PORT=8080
