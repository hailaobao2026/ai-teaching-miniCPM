# MiniCPM endpoint and model are configured in config/minicpm.json.
# Optional environment overrides for special deployments:
# VLLM_OMNI_URL=
# MINICPM_MODEL=
# Vite dev proxy target; set this when your local backend uses another port.
# MATH_COACH_API_TARGET=http://127.0.0.1:8081
VLLM_OMNI_TLS_VERIFY=true
# Optional: recognition defaults to 180s and teaching to 90s; range 10-600s.
# MINICPM_READ_TIMEOUT_SECONDS=180
# Vision requests are resized to reduce Cloudflare 524 risk; edge 640-2048.
# MINICPM_VISION_MAX_EDGE=1280
# MINICPM_VISION_JPEG_QUALITY=90
# Optional: set in config/minicpm.json or here when the endpoint enforces auth.
# MINICPM_API_KEY=
# vLLM server uses the same value with --api-key when exposed beyond loopback.
# VLLM_API_KEY=

# ---------------------------------------------------------------------------
# CORS (production: only your real browser origin(s); no wildcards)
# Dev example keeps Vite / local API origins.
# ---------------------------------------------------------------------------
MATH_COACH_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3000

# ---------------------------------------------------------------------------
# Auth / RBAC / session cookies
# ---------------------------------------------------------------------------
MATH_COACH_AUTH_REQUIRED=true
# Session cookie (HttpOnly). Secure flag is auto-enabled when HTTPS is detected,
# or force with MATH_COACH_COOKIE_SECURE=true behind a TLS-terminating proxy.
MATH_COACH_COOKIE_NAME=math_coach_token
# Docker/production default is Secure + HSTS. Set false only for plain HTTP local dev.
MATH_COACH_COOKIE_SECURE=true
MATH_COACH_COOKIE_SAMESITE=lax
# Session TTL in seconds (default 7 days)
# MATH_COACH_SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Initial admin account — REQUIRED before any public deployment.
# Do NOT use weak defaults. Generate a long random password, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# ADMIN_PASSWORD has no default; seed will refuse weak/empty values.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NICKNAME=系统管理员

# Demo accounts (students/teachers for local UX). Default OFF for safer installs.
# When true, DEMO_*_PASSWORD must be set explicitly (no built-in demo123).
SEED_DEMO_ACCOUNTS=false
DEMO_TEACHER_EMAIL=math.teacher@example.local
DEMO_TEACHER_PASSWORD=
DEMO_TEACHER_NICKNAME=数学老师
DEMO_STUDENT_EMAIL=student@example.local
DEMO_STUDENT_PASSWORD=
DEMO_STUDENT_NICKNAME=演示学生
DEMO_STUDENT_GRADE=grade8

# Optional competition demo account. The reset script defaults to this email
# and writes a generated strong password to ignored .competition.env.
MATH_COACH_COMPETITION_EMAIL=student@competition.local

# ---------------------------------------------------------------------------
# Database backend: sqlite (default) or mysql
# ---------------------------------------------------------------------------
MATH_COACH_DB_BACKEND=sqlite
MATH_COACH_SQLITE_PATH=data/math-coach.db
# Legacy JSON path is only used to derive the default sqlite directory.
MATH_COACH_AUTH_DB=data/auth-db.json

# MySQL (used when MATH_COACH_DB_BACKEND=mysql)
# SECURITY: never ship root/user passwords as "rootpass" / "mathcoach" in prod.
# Set strong unique passwords before first boot; rotate if they ever leak.
MATH_COACH_MYSQL_HOST=127.0.0.1
MATH_COACH_MYSQL_PORT=3306
MATH_COACH_MYSQL_USER=mathcoach
MATH_COACH_MYSQL_PASSWORD=
MATH_COACH_MYSQL_DATABASE=mathcoach
# Optional full DSN override (password must still be strong):
# MATH_COACH_MYSQL_DSN=mysql+pymysql://mathcoach:CHANGE_ME@127.0.0.1:3306/mathcoach

# Docker Compose MySQL profile also needs:
# MYSQL_ROOT_PASSWORD=   # strong custom root password; no default in production

# Rate limiting (requests per minute per client IP; 0 disables)
MATH_COACH_RATE_LIMIT_PER_MINUTE=120
MATH_COACH_AUTH_RATE_LIMIT_PER_MINUTE=20
# Set true only when this app is directly behind a reverse proxy that strips
# client-supplied X-Forwarded-For and appends the real client address.
MATH_COACH_TRUST_PROXY_HEADERS=false
# Expose FastAPI docs only for local/debug deployments.
MATH_COACH_ENABLE_DOCS=false

# ---------------------------------------------------------------------------
# Docker / deploy notes
# ---------------------------------------------------------------------------
# - SQLite file: /app/data/math-coach.db (volume math_coach_data)
# - MySQL: MATH_COACH_DB_BACKEND=mysql docker compose --profile mysql up --build -d
# - ALWAYS set ADMIN_PASSWORD (and MySQL passwords) before public exposure
# - Set MATH_COACH_ALLOWED_ORIGINS to your real HTTPS origin only
# - Terminate TLS at Nginx (see docs/06-部署与验证.md); set MATH_COACH_COOKIE_SECURE=true
# - MATH_COACH_PORT=8089
